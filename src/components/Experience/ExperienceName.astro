---

import type { IconType } from 'react-icons';

interface Props {
	name: string;
	icon?: IconType;
}

const { name, icon: Icon } = Astro.props;
---

<div class="flex items-baseline gap-3 text-white  font-bold tracking-[-0.0625rem] leading-tight">
  {Icon && <Icon aria-hidden="true" className="shrink-0 text-primary text-1" />}
  <span class="text-2 lg:text-3">{name}</span>
</div>
